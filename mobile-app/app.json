{
  "expo": {
    "name": "Nazdeek",
    "slug": "mobile-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "gradleVersion": "8.13",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.hamzaaa.x1897.mobileapp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-status-bar",
      [
  "expo-audio",
  {
    "microphonePermission": "Allow Nazdeek to access your microphone to record voice messages."
  }
]
    ],
    "extra": {
      "eas": {
        "projectId": "55d7db23-c6f3-4961-aef7-42c2f02eaea2"
      }
    }
  }
}
